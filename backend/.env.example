# Database
DATABASE_URL=postgresql+psycopg://spectech:spectech@postgres:5432/spectech

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=change-this-to-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application
APP_NAME=SpectechPlatform
APP_VERSION=0.1.0
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:3000
