# Database
DATABASE_URL=postgresql+psycopg://spectech:spectech@postgres:5432/spectech  # pragma: allowlist secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # pragma: allowlist secret

# JWT
JWT_SECRET_KEY=change-this-to-secure-random-string-in-production  # pragma: allowlist secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application
APP_NAME=SpectechPlatform
APP_VERSION=0.1.0
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:3000

echo # Sentry Error Tracking >> .env.example
echo SENTRY_DSN=  # pragma: allowlist secret >> .env.example
echo ENVIRONMENT=development >> .env.example

# Background Tasks
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5

# Telegram Notifications (опционально, может не работать в РФ)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=  # pragma: allowlist secret
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# Platform Owner Access (admin panel)
PLATFORM_OWNER_EMAIL=admin@spectech.dev
